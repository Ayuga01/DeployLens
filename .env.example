# Local development defaults. SQLite keeps development and tests offline.
APP_ENV=development
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./deploylens.db
POSTGRES_HOST_PORT=5433

# For the Docker Compose PostgreSQL service, use:
# DATABASE_URL=postgresql+psycopg://deploylens:deploylens@localhost:5433/deploylens
